# Read-only CKB RPC endpoint. Local HTTP is accepted only on loopback.
CKB_RPC_URL=http://127.0.0.1:8114
CKB_NETWORK=devnet
# Set to the genesis block hash reported by this exact CKB network.
CKB_GENESIS_BLOCK_HASH=0x
CKB_START_BLOCK_HEIGHT=0
CKB_CONFIRMATION_DEPTH=6
CKB_REORG_WINDOW=24
CKB_REQUEST_TIMEOUT_MS=10000
CKB_POLL_INTERVAL_MS=3000

# Select one exact lock or type script. Do not include private keys here.
CKB_TARGET_SCRIPT_ROLE=lock
CKB_TARGET_SCRIPT_CODE_HASH=0x
CKB_TARGET_SCRIPT_HASH_TYPE=type
CKB_TARGET_SCRIPT_ARGS=0x
